import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import sys
import os

# Set up paths and styling for consistent visualizations
plt.style.use('default')
sns.set_palette("husl")
%matplotlib inline  # Display plots inline in Jupyter notebook

# Add scripts directory to path to import our custom modules
current_dir = os.getcwd()
scripts_dir = os.path.join(current_dir, 'scripts')
sys.path.append(scripts_dir)  # This allows us to import from the scripts folder

print("LittleSteps Data Analysis Notebook")
print("=" * 50)

# 1. Data Generation - First step: create synthetic healthcare visit data
print("Step 1: Generating synthetic data...")
from generate_data import generate_specific_dataset, save_data

# Generate realistic healthcare visit data for analysis
df = generate_specific_dataset()
data_path = os.path.join(current_dir, 'data', 'visits.csv')
save_data(df, data_path)  # Save the generated data to CSV file
print(f"✓ Generated {len(df)} records")  # Confirm data generation success

# 2. Data Cleaning - Prepare data for analysis by handling missing values and outliers
print("\nStep 2: Cleaning data...")
from data_cleaning import DataCleaner

# Initialize the data cleaner with our generated data
cleaner = DataCleaner(data_path)
cleaned_df, report = cleaner.clean_data()  # Clean the data and get cleaning report
cleaned_data_path = os.path.join(current_dir, 'data', 'visits_cleaned.csv')
cleaned_df.to_csv(cleaned_data_path, index=False)  # Save cleaned data
print("✓ Data cleaning completed")

# Display cleaning results to understand data quality improvements
print("\nData Cleaning Summary:")
print(f"- Original records: {report['initial_rows']}")
print(f"- Duplicates removed: {report.get('duplicates_removed', 0)}")
print(f"- Duration outliers: {report.get('duration_outliers', 0)}")

# 3. Analysis - Perform comprehensive analysis on cleaned data
print("\nStep 3: Performing analysis...")
from analysis_visualization import DataAnalyzer

# Create analyzer instance and generate complete analysis report
analyzer = DataAnalyzer(cleaned_data_path)
results = analyzer.generate_report()  # Run all analysis methods
print("✓ Analysis completed")

# 4. Interactive Data Exploration - Explore the cleaned dataset interactively
print("\n" + "="*60)
print("INTERACTIVE DATA EXPLORATION")
print("="*60)

# Display basic dataset information for quick overview
print("\nCleaned Dataset Overview:")
print(f"Shape: {cleaned_df.shape}")  # Rows and columns count
print(f"Columns: {list(cleaned_df.columns)}")  # All available columns

# Show first few rows to understand data structure
print("\nFirst 5 rows of cleaned data:")
display(cleaned_df.head())  # Jupyter notebook function to display DataFrame

# Basic statistics for key numerical and categorical columns
print("\nBasic Statistics:")
print(cleaned_df[['visit_duration_minutes', 'service_type_cleaned', 'visit_location_cleaned']].describe())

# 5. Key Insights Summary with Visualizations - Present main findings
print("\n" + "="*60)
print("KEY INSIGHTS SUMMARY")
print("="*60)

# Extract descriptive statistics from analysis results
stats = results['descriptive_stats']
print(f" Overall Performance:")
print(f"   • Average visit duration: {stats['mean']:.1f} minutes")  # Mean duration
print(f"   • Median visit duration: {stats['median']:.1f} minutes")  # Middle value
print(f"   • Visit duration ranges from {stats['min']:.1f} to {stats['max']:.1f} minutes")  # Range
print(f"   • Standard deviation: {stats['std']:.1f} minutes")  # Variability measure

# Service Type Analysis - Compare different medical services
service_analysis = results['service_analysis']
print(f"\n Service Type Analysis:")
print(f"   • Longest service: {service_analysis['longest_service']} ({service_analysis['stats'].loc[service_analysis['longest_service'], 'mean']:.1f} min)")
print(f"   • Shortest service: {service_analysis['shortest_service']} ({service_analysis['stats'].loc[service_analysis['shortest_service'], 'mean']:.1f} min)")

# Location Analysis - Check if location affects visit duration
location_analysis = results['location_analysis']
print(f"\n Location Analysis:")
if location_analysis['anova_p_value'] and location_analysis['anova_p_value'] < 0.05:
    print("   •  Significant differences found across locations (p < 0.05)")  # Statistically significant
else:
    print("   •  No significant differences across locations")  # No significant pattern

# Nurse Performance - Identify best and worst performing nurses
nurse_analysis = results['nurse_analysis']
if nurse_analysis and 'bottom_3' in nurse_analysis:
    print(f"\n Nurse Performance Analysis:")
    print("   • Top performing nurses (shortest durations):")  # Most efficient nurses
    if hasattr(nurse_analysis['bottom_3'], 'iterrows'):
        for nurse, data in nurse_analysis['bottom_3'].iterrows():
            print(f"     - {nurse}: {data['mean']:.1f} minutes (n={data['count']} visits)")  # Nurse stats
    else:
        for nurse, data in nurse_analysis['bottom_3'].items():
            print(f"     - {nurse}: {data:.1f} minutes")
    
    print("   • Bottom performing nurses (longest durations):")  # Least efficient nurses
    if hasattr(nurse_analysis['top_3'], 'iterrows'):
        for nurse, data in nurse_analysis['top_3'].iterrows():
            print(f"     - {nurse}: {data['mean']:.1f} minutes (n={data['count']} visits)")
    else:
        for nurse, data in nurse_analysis['top_3'].items():
            print(f"     - {nurse}: {data:.1f} minutes")

# Notes Analysis - Extract insights from nurse notes keywords
notes_analysis = results['notes_analysis']
print(f"\n📝 Notes Keyword Analysis:")
for keyword, durations in notes_analysis.items():
    if True in durations and False in durations:
        true_avg = durations[True]  # Average when keyword is present
        false_avg = durations[False]  # Average when keyword is absent
        diff = true_avg - false_avg  # Difference in duration
        trend = "longer" if diff > 0 else "shorter"  # Determine trend direction
        print(f"   • Visits with '{keyword}': {true_avg:.1f} min ({abs(diff):.1f} min {trend} than average)")

# 6. Advanced Visualizations - Create additional custom charts
print("\n" + "="*60)
print("ADVANCED VISUALIZATIONS")
print("="*60)

# Create a 2x2 grid of advanced visualizations
fig, axes = plt.subplots(2, 2, figsize=(15, 12))

# 1. Duration distribution by service type - Bar chart comparison
service_durations = cleaned_df.groupby('service_type_cleaned')['visit_duration_minutes']
service_means = service_durations.mean().sort_values(ascending=False)  # Sort by duration
axes[0, 0].bar(service_means.index, service_means.values, color='lightblue', alpha=0.7)
axes[0, 0].set_title('Average Duration by Service Type', fontsize=14, fontweight='bold')
axes[0, 0].set_ylabel('Average Duration (minutes)')
axes[0, 0].tick_params(axis='x', rotation=45)  # Rotate labels for readability

# 2. Duration distribution by location - Compare different locations
location_durations = cleaned_df.groupby('visit_location_cleaned')['visit_duration_minutes']
location_means = location_durations.mean().sort_values(ascending=False)
axes[0, 1].bar(location_means.index, location_means.values, color='lightcoral', alpha=0.7)
axes[0, 1].set_title('Average Duration by Location', fontsize=14, fontweight='bold')
axes[0, 1].set_ylabel('Average Duration (minutes)')
axes[0, 1].tick_params(axis='x', rotation=45)

# 3. Visit distribution by hour of day - Temporal pattern analysis
cleaned_df['visit_hour'] = cleaned_df['visit_start_time'].dt.hour  # Extract hour from timestamp
hourly_counts = cleaned_df['visit_hour'].value_counts().sort_index()  # Count visits by hour
axes[1, 0].plot(hourly_counts.index, hourly_counts.values, marker='o', linewidth=2, markersize=8)
axes[1, 0].set_title('Visit Distribution by Hour of Day', fontsize=14, fontweight='bold')
axes[1, 0].set_xlabel('Hour of Day')
axes[1, 0].set_ylabel('Number of Visits')
axes[1, 0].set_xticks(range(0, 24))  # Show all hours
axes[1, 0].grid(True, alpha=0.3)  # Add grid for better readability

# 4. Outlier analysis - Pie chart showing outlier proportion
outlier_data = cleaned_df['is_duration_outlier'].value_counts()
axes[1, 1].pie(outlier_data.values, labels=['Normal', 'Outlier'], autopct='%1.1f%%', 
               colors=['lightgreen', 'salmon'], startangle=90)
axes[1, 1].set_title('Visit Duration Outliers', fontsize=14, fontweight='bold')

plt.tight_layout()  # Adjust spacing between subplots
plt.show()

# 7. Correlation Analysis - Examine relationships between numerical variables
print("\n" + "="*60)
print("CORRELATION ANALYSIS")
print("="*60)

# Create correlation matrix to understand variable relationships
numerical_cols = ['visit_duration_minutes', 'visit_hour']  # Numerical columns for correlation
correlation_data = cleaned_df[numerical_cols].corr()  # Calculate correlation matrix

plt.figure(figsize=(8, 6))
sns.heatmap(correlation_data, annot=True, cmap='coolwarm', center=0,
            square=True, linewidths=0.5)  # Create heatmap visualization
plt.title('Correlation Matrix', fontsize=14, fontweight='bold')
plt.show()

