print("\n" + "="*60)
print("EXPORTING RESULTS")
print("="*60)

# Save summary statistics to JSON file for reporting
summary_stats = {
    'total_visits': len(cleaned_df),  # Total number of visits analyzed
    'avg_duration': stats['mean'],  # Average visit duration
    'median_duration': stats['median'],  # Median visit duration
    'service_types': cleaned_df['service_type_cleaned'].nunique(),  # Number of service types
    'locations': cleaned_df['visit_location_cleaned'].nunique(),  # Number of locations
    'nurses': cleaned_df['nurse_id'].nunique(),  # Number of nurses
